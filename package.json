{
  "name": "codenames-online",
  "private": true,
  "version": "0.9.2",
  "description": "行动代号线下发牌器",
  "author": "codenames",
  "type": "module",
  "main": "apps/desktop/dist/main.cjs",
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "build": "pnpm -r build",
    "clean:release": "node -e \"require('node:fs').rmSync('release',{recursive:true,force:true})\"",
    "desktop:build": "pnpm -r --filter @codenames/shared --filter @codenames/game-core --filter @codenames/server --filter @codenames/web --filter @codenames/entry --filter @codenames/desktop build",
    "desktop:dev": "pnpm desktop:build && electron .",
    "desktop:pack": "pnpm clean:release && pnpm desktop:build && electron-builder --dir",
    "desktop:dist": "pnpm clean:release && pnpm desktop:build && electron-builder",
    "dev": "pnpm --parallel --filter @codenames/server --filter @codenames/web --filter @codenames/entry dev",
    "dev:entry": "pnpm --parallel --filter @codenames/server --filter @codenames/web --filter @codenames/entry dev",
    "entry:dev": "pnpm --filter @codenames/entry dev",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "playwright": "^1.59.1"
  },
  "dependencies": {
    "@codenames/game-core": "workspace:*",
    "@codenames/server": "workspace:*",
    "@codenames/shared": "workspace:*",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "openai": "^6.3.0",
    "socket.io": "^4.8.1",
    "zod": "^4.1.12"
  },
  "build": {
    "appId": "com.codenames.dealer",
    "productName": "行动代号",
    "directories": {
      "output": "release"
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "files": [
      "apps/desktop/dist/**/*",
      "apps/web/dist/**/*",
      "apps/entry/dist/**/*",
      "apps/server/dist/**/*",
      "packages/shared/dist/**/*",
      "packages/game-core/dist/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "artifactName": "codenames-${version}-windows-${arch}.${ext}",
      "icon": "build/icon.ico",
      "target": [
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game"
    },
    "mac": {
      "artifactName": "codenames-${version}-macos-${arch}.${ext}",
      "target": [
        "zip"
      ],
      "category": "public.app-category.games"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller"
    ]
  }
}
